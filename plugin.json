{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "no-short",
  "version": "0.4.3",
  "description": "Local Codex and Claude Code usage estimates, with a macOS menu bar app and Codex panel. Built by Long.",
  "author": {
    "name": "Long",
    "url": "https://github.com/longlonglong173"
  },
  "homepage": "https://github.com/longlonglong173/no-short",
  "repository": "https://github.com/longlonglong173/no-short",
  "keywords": [
    "usage",
    "macos",
    "codex",
    "claude-code",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "No Short Usage",
        "shortDescription": "Local AI usage and context",
        "longDescription": "Track local Codex and Claude Code usage in the macOS menu bar, with an optional Codex usage panel. Costs are API-equivalent estimates, not subscription bills or credits. Reusable writing and reporting skills are distributed separately as No Short Skills.",
        "developerName": "Long",
        "category": "Productivity",
        "websiteURL": "https://github.com/longlonglong173/no-short",
        "supportURL": "https://github.com/longlonglong173/no-short/issues",
        "privacyPolicyURL": "https://github.com/longlonglong173/no-short/blob/main/PRIVACY.md",
        "composerIcon": "./assets/long-mini.png",
        "logo": "./assets/long-mini.png"
      },
      "requires_local_executor": true
    }
  }
}
