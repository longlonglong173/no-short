+// No Short Usage NS-20: report IDs are relative paths, but Codex rollout names
+// retain their logical UUID when moved or renamed. Fall back to the existing
+// identity when no validated UUID suffix exists; do not infer it from usage.
+pub(crate) fn codex_session_identity(value: &str) -> std::borrow::Cow<'_, str> {
+    let Some(candidate) = value.get(value.len().saturating_sub(36)..) else {
+        return std::borrow::Cow::Borrowed(value);
+    };
+    if candidate.len() != 36 || !candidate.bytes().enumerate().all(|(index, byte)| {
+        if matches!(index, 8 | 13 | 18 | 23) { byte == b'-' } else { byte.is_ascii_hexdigit() }
+    }) {
+        return std::borrow::Cow::Borrowed(value);
+    }
+    if candidate.bytes().any(|byte| byte.is_ascii_uppercase()) {
+        std::borrow::Cow::Owned(candidate.to_ascii_lowercase())
+    } else {
+        std::borrow::Cow::Borrowed(candidate)
+    }
+}
