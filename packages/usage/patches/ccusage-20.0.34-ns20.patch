+// Load each supported source exactly once, preserving canonical identity/replay decisions.
+fn load_session_day_sources(shared: &SharedArgs, pricing: &PricingMap) -> Result<([AgentRows; 2], [AgentRows; 2], Vec<(String, AllRow)>)> {
+    let mut ledger = Vec::new();
+    let mut entries = claude::load_entries(shared, None)?;
+    let claude_detected = !entries.is_empty();
+    let mut lifetime = summarize_entry_sessions(&entries)?;
+    filter_session_summaries(&mut lifetime, shared);
+    let claude_sessions = AgentRows { rows: summary_rows("claude", lifetime, false), detected: claude_detected };
+    filter_loaded_entries_by_date(&mut entries, shared);
+    let mut groups = BTreeMap::<(String, String, String), SessionAccumulator>::new();
+    for entry in &entries {
+        groups.entry((entry.date.clone(), entry.project_path.to_string(), entry.session_id.to_string())).or_default().add_entry(entry);
+    }
+    let mut claude_day_rows = Vec::new();
+    for ((date, _, _), group) in groups {
+        let rows = summary_rows("claude", vec![group.into_summary()?], false);
+        for row in rows {
+            ledger.push((date.clone(), row.clone()));
+            claude_day_rows.push(AllRow { period: date.clone(), ..row });
+        }
+    }
+    let claude_daily = AgentRows { rows: claude_day_rows, detected: claude_detected };
+    let (mut events, detected) = codex::load_codex_events_with_detection(shared)?;
+    let speed = codex::resolve_codex_speed(CodexSpeed::Auto);
+    let sessions = codex::aggregate_events(&events, AgentReportKind::Session, shared.timezone.as_deref())?;
+    let codex_sessions = AgentRows { rows: sessions.iter().map(|(id,g)| codex_group_row(id,g,pricing,speed,shared.mode)).collect(), detected };
+    codex::filter_events_by_date(&mut events, shared)?;
+    let daily = codex::aggregate_events(&events, AgentReportKind::Daily, shared.timezone.as_deref())?;
+    let codex_daily = AgentRows { rows: daily.iter().map(|(d,g)| codex_group_row(d,g,pricing,speed,shared.mode)).collect(), detected };
+    for (key, group) in codex::aggregate_session_days(&events, shared.timezone.as_deref())? {
+        let (date, session) = key.split_once('\0').expect("internal ledger key");
+        ledger.push((date.to_string(), codex_group_row(session,&group,pricing,speed,shared.mode)));
+    }
+    ledger.sort_by(|(a,x),(b,y)| (a,x.agent,&x.period).cmp(&(b,y.agent,&y.period)));
+    Ok(([claude_daily, codex_daily], [claude_sessions, codex_sessions], ledger))
+}
