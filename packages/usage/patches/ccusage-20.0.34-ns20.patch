+// Choose from every scanned file, not just those whose events won deduplication.
+// Keeping the smallest existing path identity makes the choice independent of
+// source order and preserves the existing public report-ID shape.
+fn representative_report_ids(files: &[(PathBuf, &Path)]) -> HashMap<String, String> {
+    let mut representatives = HashMap::<String, String>::new();
+    for (path, sessions_dir) in files {
+        let report_id = super::parser::codex_session_id(sessions_dir, path);
+        let identity = crate::types::codex_session_identity(&report_id).into_owned();
+        representatives.entry(identity).and_modify(|current| {
+            if report_id < *current { current.clone_from(&report_id); }
+        }).or_insert(report_id);
+    }
+    representatives
 }
 
