{
  "name": "no-short",
  "version": "0.4.3",
  "private": true,
  "description": "Local Codex and Claude Code usage estimates, with a macOS menu bar app and Codex panel. Built by Long.",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "bun test ./packages/usage/tests/*.test.ts",
    "typecheck:usage": "bun run --cwd packages/usage typecheck",
    "test:usage:browser": "bun run --cwd packages/usage test:browser",
    "build:usage": "bun run --cwd packages/usage build",
    "package:usage": "bun run --cwd packages/usage package",
    "smoke:usage": "bun run --cwd packages/usage smoke",
    "test:usage-menubar": "bun packages/usage-menubar/scripts/test.ts",
    "build:usage-menubar": "bun packages/usage-menubar/scripts/build.ts",
    "smoke:usage-menubar": "bun packages/usage-menubar/scripts/smoke.ts",
    "package:usage-menubar": "bun packages/usage-menubar/scripts/package.ts",
    "release:usage-menubar": "bun packages/usage-menubar/scripts/release.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longlonglong173/no-short.git"
  },
  "engines": {
    "node": ">=18"
  }
}
